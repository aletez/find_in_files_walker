[
	{"caption": "Find In Files Walker: New Window", "command": "walker_open", "args": {"new_window": true}},
	{"caption": "Find In Files Walker: Same Window", "command": "walker_open", "args": {"new_window": false}},
	{"caption": "Find In Files Walker: Next Match", "command": "walker_walk", "args": {"action": "next"}},
	{"caption": "Find In Files Walker: Previous Match", "command": "walker_walk", "args": {"action": "prev"}},
	{"caption": "Find In Files Walker: Close Walked Files", "command": "walker_close_files"},
	{"caption": "Find In Files Walker: Keep One Walked File", "command": "walker_close_files_keep_one"},
    {
        "caption": "Preferences: FindInFilesWalker Key Bindings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/FindInFilesWalker/Default.sublime-keymap",
            "user_file": "${packages}/User/Default (${platform}).sublime-keymap"
        }
    }

]